# One file per environment, next to a copy of deploy/compose.yml:
#   /srv/openeam/prod/.env, /srv/openeam/staging/.env
# Never committed. chmod 600.

# Names the Compose project, its containers, network and volume, and the alias
# the proxy reaches the web container by (<name>-web). One per environment.
COMPOSE_PROJECT_NAME=openeam-prod

# Public hostname of this environment. Becomes WEB_ORIGIN (https://…).
OPENEAM_HOST=eam.example.com

# Image tag to run. The deploy script writes this on every deploy:
# an immutable sha-… tag for staging, the release tag (v1.2.3) for prod.
OPENEAM_TAG=v0.1.0

# Registry prefix; -api and -web are appended. Change for a fork.
OPENEAM_IMAGE=ghcr.io/0xntl/openeam

# --- Postgres (only reachable inside this stack) ---
POSTGRES_USER=openeam
POSTGRES_PASSWORD=
POSTGRES_DB=openeam

# Seeds the sign-up switch on an empty instance; the Administration page owns
# it afterwards. The first account can always be created.
AUTH_ALLOW_SIGNUP=false
