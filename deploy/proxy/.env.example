# Copy to .env next to the proxy compose.yml. Never committed. chmod 600.

# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.com

PROD_HOST=eam.example.com
STAGING_HOST=staging.eam.example.com

# Basic auth in front of staging. Make the hash with
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'the password'
# and keep the single quotes: the hash contains `$`, which Compose would
# otherwise try to interpolate.
STAGING_USER=team
STAGING_PASSWORD_HASH='$2a$14$replace-me'
