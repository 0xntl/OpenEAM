# Nightly dump of one environment; the instance name is the environment.
#   install -m 644 deploy/systemd/openeam-backup@.* /etc/systemd/system/
#   systemctl enable --now openeam-backup@prod.timer
[Unit]
Description=OpenEAM database backup (%i)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
ExecStart=/srv/openeam/bin/backup.sh %i
