{
  "name": "openeam",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Enterprise Architecture Management tool",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @openeam/db build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:examples": "node scripts/check-example-icons.mjs",
    "db:generate": "pnpm --filter @openeam/db generate",
    "db:migrate": "pnpm --filter @openeam/db migrate",
    "db:studio": "pnpm --filter @openeam/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "typescript": "6.0.3"
  }
}
