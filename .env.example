# Copy to .env and adjust as needed.
# This file is committed; .env is gitignored.

# --- Postgres ---
POSTGRES_USER=openeam
POSTGRES_PASSWORD=openeam
POSTGRES_DB=openeam
POSTGRES_PORT=5432

# Connection string used by Drizzle / NestJS.
# In Docker Compose the host is "postgres" (service name).
# For local `pnpm dev` against the Compose Postgres, use localhost.
DATABASE_URL=postgres://openeam:openeam@localhost:5432/openeam

# --- API (apps/api) ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Accounts: the first account can always be created and is the instance admin.
# Whether anyone else may sign up is switched on the Administration page; this
# value only seeds that switch on an empty instance.
AUTH_ALLOW_SIGNUP=false
# Mark the session cookie Secure. Leave false on plain HTTP (local dev, a LAN
# box); set true behind TLS.
AUTH_COOKIE_SECURE=false
# Reverse proxies in front of the API (0 for `pnpm dev`; the Compose setup
# sets 1 itself). Determines which X-Forwarded-For hop is the client.
TRUST_PROXY=0

# --- Web (apps/web) ---
# Port of the Vite dev server; also the API's allowed CORS origin (WEB_ORIGIN).
WEB_PORT=3000
# Build-time var baked into the SPA. Leave empty: in dev Vite proxies /graphql
# and /health to the API, in the container build nginx does. A build that
# talks to an API on another origin is not supported — the session cookie is
# SameSite=Lax and would not be sent cross-site.
VITE_API_URL=

# --- Self-hosted containers (docker compose --profile app) ---
# Host port the web container is published on.
OPENEAM_PORT=8080
# Public origin of the instance, used as the API's CORS origin.
OPENEAM_ORIGIN=http://localhost:8080
